# Copy this file to `.streamlit/secrets.toml` (gitignored) to enable the
# AI "Ask the data" feature locally. On Streamlit Community Cloud, paste the
# same keys under App → Settings → Secrets instead.
#
# The dashboard works fully WITHOUT any of these — the AI tab just shows a notice.
#
# Add ANY ONE provider key and it is used automatically. If several are present,
# the order of preference is: Grok (xAI) → Anthropic → OpenAI → Gemini (override with LLM_PROVIDER).

# --- Pick one (or more) ---
GROK_API_KEY      = "xai-..."          # xAI Grok API Key
# XAI_API_KEY     = "xai-..."
# ANTHROPIC_API_KEY = "sk-ant-..."
# OPENAI_API_KEY  = "sk-..."
# GEMINI_API_KEY  = "AIza..."

# --- Optional overrides ---
# LLM_PROVIDER = "grok"                # force a provider: grok | anthropic | openai | gemini
# LLM_MODEL    = "grok-2-latest"       # custom model name
#   grok      default: grok-2-latest   (or grok-beta, grok-2-vision-1212)
#   anthropic default: claude-3-5-haiku-20241022
#   openai    default: gpt-4o-mini
#   gemini    default: gemini-2.0-flash
